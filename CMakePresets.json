{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (CUDA native architecture)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROGRAMMING_LAB_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (CUDA native architecture)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROGRAMMING_LAB_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "host-cpu",
      "displayName": "Host CPU-only Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROGRAMMING_LAB_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "host-gpu",
      "displayName": "Host CPU+GPU Debug (locked CUDA native architecture)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROGRAMMING_LAB_ENABLE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "host-cpu",
      "configurePreset": "host-cpu"
    },
    {
      "name": "host-gpu",
      "configurePreset": "host-gpu"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-cpu",
      "configurePreset": "host-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-gpu",
      "configurePreset": "host-gpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
