# shellcheck shell=bash
# ~/.bashrc for the programming-lab development user.

case $- in
  *i*) ;;
  *) return ;;
esac

export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
fi

export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$HOME/.venvs/programming-lab}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$HOME/.cache/uv}"
export UV_PYTHON_PREFERENCE="${UV_PYTHON_PREFERENCE:-only-managed}"

if [[ -f "$UV_PROJECT_ENVIRONMENT/bin/activate" ]]; then
  # This environment is created and managed by uv.
  # shellcheck source=/dev/null
  . "$UV_PROJECT_ENVIRONMENT/bin/activate"
fi

if [[ -f /etc/bash_completion ]]; then
  # shellcheck source=/dev/null
  . /etc/bash_completion
fi

# Proxy Codex only when the selected container network mode enables the
# sidecar. `env ... codex` resolves the executable instead of recursing into
# the shell function below.
codex-proxy() {
  if [[ "${PROGRAMMING_LAB_PROXY_MODE:-direct}" != "proxy" ]]; then
    echo "Proxy mode is disabled for this development container." >&2
    return 2
  fi

  local http_proxy="${CODEX_HTTP_PROXY:-${V2RAYA_HTTP_PROXY:-}}"
  local socks_proxy="${CODEX_SOCKS_PROXY:-${V2RAYA_SOCKS_PROXY:-}}"
  local no_proxy="${CODEX_NO_PROXY:-${V2RAYA_NO_PROXY:-}}"

  if [[ -z "${http_proxy}" || -z "${socks_proxy}" ]]; then
    echo "Proxy mode is enabled, but its HTTP or SOCKS5 endpoint is missing." >&2
    return 2
  fi

  env \
    HTTP_PROXY="${http_proxy}" \
    HTTPS_PROXY="${http_proxy}" \
    ALL_PROXY="${socks_proxy}" \
    NO_PROXY="${no_proxy}" \
    http_proxy="${http_proxy}" \
    https_proxy="${http_proxy}" \
    all_proxy="${socks_proxy}" \
    no_proxy="${no_proxy}" \
    codex "$@"
}

codex() {
  if [[ "${PROGRAMMING_LAB_PROXY_MODE:-direct}" == "proxy" ]]; then
    codex-proxy "$@"
  else
    codex-direct "$@"
  fi
}

codex-direct() {
  env \
    -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY \
    -u http_proxy -u https_proxy -u all_proxy -u no_proxy \
    codex "$@"
}

alias proxy-on='source /workspace/programming-lab/scripts/proxy-env.sh on'
alias proxy-off='source /workspace/programming-lab/scripts/proxy-env.sh off'
alias proxy-status='source /workspace/programming-lab/scripts/proxy-env.sh status'

alias ll='ls -alF'
alias gs='git status --short --branch'

PS1='\[\033[01;32m\]\u@programming-lab\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
