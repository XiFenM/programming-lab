{
  "schema": "agent-skills.memo-cards/v1",
  "skill": "memo-cards",
  "adapter": {
    "id": "markji",
    "client_version": "3.8.00",
    "profile": "programming-lab-markji"
  },
  "input_collections": [
    {
      "id": "algorithm-interview-study-logs",
      "kind": "structured-log",
      "patterns": [
        "docs/algorithm-interview-learning/logs/*.md"
      ]
    },
    {
      "id": "triton-study-logs",
      "kind": "structured-log",
      "patterns": [
        "docs/triton-learning/logs/*.md"
      ]
    }
  ],
  "output_collections": [
    {
      "id": "algorithm-interview-cards",
      "patterns": [
        "docs/algorithm-interview-learning/cards/algorithm-interview-*.md"
      ],
      "inventory_patterns": [
        "docs/algorithm-interview-learning/cards/algorithm-interview-*.md"
      ]
    },
    {
      "id": "triton-cards",
      "patterns": [
        "docs/triton-learning/cards/triton-*.md"
      ],
      "inventory_patterns": [
        "docs/triton-learning/cards/triton-*.md"
      ]
    }
  ]
}
